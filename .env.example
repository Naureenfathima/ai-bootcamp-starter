# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in your values.
#
# NEVER commit .env to Git. It is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="AI Bootcamp Starter"
APP_VERSION="1.0.0"
DEBUG=false

# ── Claude / Anthropic ─────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Options: "openai" | "cohere" | "local"
# Use "local" during development to avoid API costs (requires sentence-transformers)
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Vector Database ────────────────────────────────────────────────────────────
# Options: "memory" (dev, no setup) | "pgvector" (production)
VECTOR_STORE=memory
DATABASE_URL=postgresql://user:password@localhost:5432/aibootcamp

# ── Voice AI ───────────────────────────────────────────────────────────────────
# Deepgram (STT): https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# ElevenLabs (TTS): https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── RAG ────────────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.7

# ── Agent ──────────────────────────────────────────────────────────────────────
MAX_AGENT_STEPS=10
AGENT_TEMPERATURE=0.2

# ── Agentic RAG ────────────────────────────────────────────────────────────────
AGENTIC_MAX_ITERATIONS=3
AGENTIC_REFLECTION_THRESHOLD=0.7

# ── Page Index ─────────────────────────────────────────────────────────────────
PAGE_INDEX_PAGE_SIZE=800

# ── Voice AI (advanced) ────────────────────────────────────────────────────────
VOICE_STT_CONFIDENCE_THRESHOLD=0.5

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "anthropic" | "openai" | "ollama" | "groq" | "together" | "openrouter"
# Only the key matching your chosen provider is required.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

GROQ_API_KEY=your_groq_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434/v1   # use this after SSH tunnel for remote Ollama
